# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Client Configuration (Vite requires VITE_ prefix for frontend access)
# Required. See SUPABASE_SETUP.md. Never put the service_role key in this file.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key-here"

# Google OAuth 2.0 Web Client ID (for Google Sign-In)
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth 2.0 Client ID (Web)
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
